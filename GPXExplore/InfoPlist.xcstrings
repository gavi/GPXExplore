        "es" : { "stringUnit" : { "state" : "translated", "value" : "Muestra tu ubicación en el mapa para ayudarte a seguir las rutas" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ルートをたどれるように、現在地を地図に表示します" } }
