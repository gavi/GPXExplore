            "value": "負荷（勾配と距離）に応じた色"
          }
        }
      }
    },
    "Colors based purely on elevation gradient": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farben rein nach Höhe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs selon l'altitude seule"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colores solo según la altitud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標高のみに応じた色"
          }
        }
      }
    },
    "Controls the number of data points shown in the elevation chart. Higher values show more detail but may impact performance with large tracks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wie viele Datenpunkte das Höhendiagramm zeigt. Höhere Werte zeigen mehr Details, können bei großen Tracks aber langsamer sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de points affichés dans le graphique d'altitude. Plus la valeur est haute, plus il y a de détail, au prix de la fluidité sur les longues traces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos puntos muestra la gráfica de altitud. Valores altos muestran más detalle pero pueden ir más lentos con rutas grandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標高グラフに表示するデータ点の数です。大きいほど詳細になりますが、大きなトラックでは遅くなることがあります。"
          }
        }
      }
    },
    "Controls whether the elevation chart overlay appears by default when opening GPX files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, ob das Höhendiagramm beim Öffnen einer GPX-Datei standardmäßig angezeigt wird"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le graphique d'altitude par défaut à l'ouverture d'un fichier GPX"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la gráfica de altitud por defecto al abrir un archivo GPX"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPXファイルを開いたときに標高グラフを最初から表示するかどうか"
          }
        }
      }
    },
    "Controls whether the route information overlay appears by default when opening GPX files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
